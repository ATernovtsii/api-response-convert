{
  "name": "tandrewcl/api-response-convert",
  "type": "symfony-bundle",
  "description": "Simple json response converter",
  "keywords": [
    "response converter. json response converter. symfony response converter"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Andrew Ternovtsii",
      "email": "at@conciliolabs.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "symfony/http-foundation": "^6.4|^7.0|^8.0",
    "symfony/http-kernel": "^6.4|^7.0|^8.0",
    "symfony/dependency-injection": "^6.4|^7.0|^8.0",
    "symfony/config": "^6.4|^7.0|^8.0"
  },
  "suggest": {
    "symfony/translation": "To use translated messages in responses"
  },
  "autoload": {
    "psr-4": {
      "tandrewcl\\ApiResponseConvertBundle\\": ""
    }
  }
}
